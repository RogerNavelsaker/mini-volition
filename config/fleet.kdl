layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="agents" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="CLAUDE" command="bash" {
                    args "-lc" "AGENT_NAME=claude AGENT_COMMAND='bunx --bun @agentclientprotocol/claude-agent-acp' AGENT_PROMPT_MODE=acp AGENT_MAIL_BIN='agent-mail' AGENT_MAIL_DB='./runtime/agent-mail.db' AGENT_JOBS_DB='./runtime/agent-jobs.db' AGENT_MEMORY_DB='./runtime/agent-memory.db' AGENT_STATE_DB='./runtime/agent-state.db' FLEET_LIBRARIAN_DB='./runtime/fleet-librarian.db' FLEET_EMBED_SOCKET='./runtime/embed.sock' FLEET_E2B_SOCKET='./runtime/e2b.sock' agent-harness < /dev/null"
                }
                pane name="GEMINI" command="bash" {
                    args "-lc" "AGENT_NAME=gemini AGENT_COMMAND='/home/rona/.flox/run/x86_64-linux.default.run/bin/gmi --acp --model gemini-3.1-pro-preview' AGENT_PROMPT_MODE=acp AGENT_MAIL_BIN='agent-mail' AGENT_MAIL_DB='./runtime/agent-mail.db' AGENT_JOBS_DB='./runtime/agent-jobs.db' AGENT_MEMORY_DB='./runtime/agent-memory.db' AGENT_STATE_DB='./runtime/agent-state.db' FLEET_LIBRARIAN_DB='./runtime/fleet-librarian.db' FLEET_EMBED_SOCKET='./runtime/embed.sock' FLEET_E2B_SOCKET='./runtime/e2b.sock' agent-harness < /dev/null"
                }
                pane name="CODEX" command="bash" {
                    args "-lc" "AGENT_NAME=codex AGENT_COMMAND='bunx --bun @zed-industries/codex-acp' AGENT_PROMPT_MODE=acp AGENT_MAIL_BIN='agent-mail' AGENT_MAIL_DB='./runtime/agent-mail.db' AGENT_JOBS_DB='./runtime/agent-jobs.db' AGENT_MEMORY_DB='./runtime/agent-memory.db' AGENT_STATE_DB='./runtime/agent-state.db' FLEET_LIBRARIAN_DB='./runtime/fleet-librarian.db' FLEET_EMBED_SOCKET='./runtime/embed.sock' FLEET_E2B_SOCKET='./runtime/e2b.sock' agent-harness < /dev/null"
                }
            }
            pane split_direction="vertical" {
                pane name="TOWN SQUARE" command="bash" {
                    args "-lc" "AGENT_MAIL_DB='./runtime/agent-mail.db' agent-mail tail public < /dev/null"
                }
                pane name="DIGEST" command="bash" {
                    args "-lc" "AGENT_MAIL_DB='./runtime/agent-mail.db' AGENT_MEMORY_DB='./runtime/agent-memory.db' AGENT_STATE_DB='./runtime/agent-state.db' AGENT_MAIL_BIN='agent-mail' FLEET_E2B_SOCKET='./runtime/e2b.sock' fleet-digest < /dev/null"
                }
                pane name="MEMORY" command="bash" {
                    args "-lc" "AGENT_JOBS_DB='./runtime/agent-jobs.db' AGENT_MEMORY_DB='./runtime/agent-memory.db' AGENT_STATE_DB='./runtime/agent-state.db' FLEET_LIBRARIAN_DB='./runtime/fleet-librarian.db' AGENT_MEMORY_BIN='agent-memory' fleet-librarian < /dev/null"
                }
                pane name="OPERATOR" focus=true command="bash" {
                    args "-lc" "AGENT_MAIL_DB='./runtime/agent-mail.db' operator-harness"
                }
            }
        }
    }

    tab name="inference" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="EMBED" command="bash" {
                    args "-lc" "export LD_LIBRARY_PATH=\"$(dirname \"$(g++ -print-file-name=libstdc++.so.6)\"):./build/node_modules/onnxruntime-node/bin/napi-v6/linux/x64:${LD_LIBRARY_PATH}\" && FLEET_EMBED_SOCKET='./runtime/embed.sock' fleet-embed < /dev/null"
                }
                pane name="RERANK" command="bash" {
                    args "-lc" "export LD_LIBRARY_PATH=\"$(dirname \"$(g++ -print-file-name=libstdc++.so.6)\"):./build/node_modules/onnxruntime-node/bin/napi-v6/linux/x64:${LD_LIBRARY_PATH}\" && FLEET_RERANK_SOCKET='./runtime/rerank.sock' fleet-rerank < /dev/null"
                }
            }
            pane split_direction="vertical" {
                pane name="E2B" command="bash" {
                    args "-lc" "export LD_LIBRARY_PATH=\"$(dirname \"$(g++ -print-file-name=libstdc++.so.6)\"):./build/node_modules/onnxruntime-node/bin/napi-v6/linux/x64:${LD_LIBRARY_PATH}\" && FLEET_E2B_SOCKET='./runtime/e2b.sock' fleet-e2b < /dev/null"
                }
                pane name="E4B" command="bash" {
                    args "-lc" "export LD_LIBRARY_PATH=\"$(dirname \"$(g++ -print-file-name=libstdc++.so.6)\"):./build/node_modules/onnxruntime-node/bin/napi-v6/linux/x64:${LD_LIBRARY_PATH}\" && FLEET_E4B_SOCKET='./runtime/e4b.sock' fleet-e4b < /dev/null"
                }
            }
        }
    }
}
